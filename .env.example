DEBUG=1
SECRET_KEY=replace-this-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=1
# sqlite keeps the project usable without a database server.
DB_ENGINE=sqlite
# For MySQL/MariaDB, set DB_ENGINE=mysql and fill in these connection values.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional CA certificate path for managed databases that require TLS.
DB_SSL_CA=
