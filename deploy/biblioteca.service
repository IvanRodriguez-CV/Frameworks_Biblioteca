[Unit]
Description=Uvicorn service for the Biblioteca FastAPI application
After=network.target

[Service]
Type=simple
User=biblioteca
Group=www-data
WorkingDirectory=/opt/biblioteca/app
EnvironmentFile=/etc/biblioteca/biblioteca.env
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=biblioteca
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/opt/biblioteca/venv-fastapi/bin/uvicorn app.main:app --workers 2 --uds /run/biblioteca/uvicorn.sock --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
